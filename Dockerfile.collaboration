FROM oven/bun:1.4.0
WORKDIR /app
COPY package.json bun.lock ./
COPY patches ./patches
RUN bun install --frozen-lockfile
COPY --chown=bun:bun . .
ENV NODE_ENV=production COLLABORATION_HOST=0.0.0.0 COLLABORATION_PORT=1234
RUN mkdir -p /app/storage && chown bun:bun /app/storage
USER bun
EXPOSE 1234
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=3 \
  CMD bun -e 'const r = await fetch("http://127.0.0.1:1234/health"); process.exit(r.ok ? 0 : 1)'
CMD ["bun", "server/workers/collaboration.ts"]
