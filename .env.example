# Copy to .env.local and fill in values for your app.
APP_URL=http://localhost:3000
# Stable public URL clients use for the hosted MCP server. Defaults to
# ${APP_URL}/mcp when omitted. The OAuth audience is bound to this exact URL,
# so keep it stable and avoid redirects.
# MCP_RESOURCE_URL=https://haunter.app/mcp
# Browser-based MCP clients send Origin and must match an app/auth origin or
# one of these additional exact origins. Server-side clients omit Origin.
# MCP_ALLOWED_ORIGINS=https://client.example.com

# Dev-only default; remove or protect in production.
DEVTOOLS_ENABLED=true

LOG_LEVEL=info
LOG_FORMAT=json
LOG_SERVICE=haunter

# Use file:local.db for local libSQL or libsql://... for Turso cloud.
SQLITE_DB_URL=file:local.db
# SQLITE_DB_AUTH_TOKEN=

# Optional for local development; required in production.
# BETTER_AUTH_SECRET=replace-with-a-random-32-character-secret
# Optional override when Better Auth has a different public origin from APP_URL.
# BETTER_AUTH_URL=https://auth.example.com
# Additional hostnames when the app is served from multiple domains. Do not
# include a protocol or path. Better Auth wildcard patterns are supported.
# Vercel hosts are detected when system environment variables are exposed.
# BETTER_AUTH_ALLOWED_HOSTS=preview-*.example.com
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Fresh installs only: this verified email becomes the first approved app-wide
# admin when no approved admin exists. Leave unset on established installs.
# BOOTSTRAP_ADMIN_EMAIL=you@example.com

# Email sign-in codes (Resend). Both are required to boot. In development the
# code is also logged to the server console, so this placeholder key works
# locally; use a real Resend key and a verified sender in production.
RESEND_API_KEY=re_dev_placeholder
RESEND_FROM=Haunter <onboarding@resend.dev>


# Vercel Blob storage (production). Leave unset locally to use ./storage.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Upstash Redis for durable rate limiting (production). Leave unset locally
# to use an in-process limiter.
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

# Liveblocks is required. It stores the authoritative Yjs documents for page
# titles, page blocks, and canvases. Configure the ydocUpdated webhook at
# /api/webhooks/liveblocks so SQLite search/share/task projections stay fresh.
LIVEBLOCKS_SECRET_KEY=sk_...
LIVEBLOCKS_WEBHOOK_SECRET=whsec_...

# tldraw license key — REQUIRED on production domains. Without it tldraw 5.x
# locks the editor outside localhost (the canvas renders as an empty black
# box). Get a free (watermarked) or paid key at https://tldraw.dev.
# NEXT_PUBLIC_TLDRAW_LICENSE_KEY=tldraw-...
CRON_SECRET=replace-with-a-random-secret
# Generate this pair with: bunx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:notifications@haunter.app
